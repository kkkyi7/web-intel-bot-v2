# ============================================================
# web-intel-bot · 环境变量配置
# ============================================================
# 使用：复制一份改名为 .env，填入你的真实值。不要把 .env 上传到 GitHub。
# ============================================================

# ============ YouTube API Key（免费，必填）============
# 去 console.cloud.google.com 拿
YOUTUBE_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx


# ============ 大模型配置（二选一路线）============
#
# ⭐ 路线 A：国产便宜模型（支付宝充值，推荐）
# ⭐ 路线 B：Claude API（国际信用卡，贵但质量最高）
#
# -------------------------------------------------------------
# 路线 A · 国产模型（默认 DeepSeek）· 下面四选一
# -------------------------------------------------------------

# ---- A1. DeepSeek（推荐，中文强，最便宜）----
# 注册：https://platform.deepseek.com   支付宝充值最低 ¥10
# 价格：输入 ¥0.5/M tokens，输出 ¥1.5/M（比 Claude Haiku 便宜 10 倍）
LLM_PROVIDER=deepseek
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# LLM_MODEL=deepseek-chat     # 默认这个，不用改
#                              # 高级版本用 deepseek-reasoner（慢但更聪明）

# ---- A2. 通义千问 Qwen（阿里云）----
# 注册：https://bailian.console.aliyun.com   支付宝结算
# 价格：qwen-turbo 输入 ¥0.3/M 输出 ¥0.6/M
# LLM_PROVIDER=qwen
# LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# LLM_MODEL=qwen-turbo        # 可选: qwen-turbo / qwen-plus / qwen-max

# ---- A3. Kimi（月之暗面，长上下文友好）----
# 注册：https://platform.moonshot.cn
# LLM_PROVIDER=kimi
# LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# LLM_MODEL=moonshot-v1-8k    # 可选: moonshot-v1-8k / 32k / 128k

# ---- A4. 智谱 GLM-4-Flash（有免费额度！）----
# 注册：https://open.bigmodel.cn
# GLM-4-Flash 对个人用户完全免费，对付日常摘要足够
# LLM_PROVIDER=zhipu
# LLM_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.xxxxxxxxxxxxxxxx
# LLM_MODEL=glm-4-flash

# -------------------------------------------------------------
# 路线 B · Claude API（原始方案，需要国际信用卡）
# -------------------------------------------------------------
# 注意：这和 Claude Max 订阅是两套账号！要单独充值
# LLM_PROVIDER=anthropic
# LLM_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# LLM_MODEL=claude-haiku-4-5-20251001


# ============ 邮件（选填，不填就只存本地）============
# Gmail:  smtp.gmail.com / 465
# 163:    smtp.163.com / 465
# QQ:     smtp.qq.com / 465
SMTP_HOST=smtp.163.com
SMTP_PORT=465
SMTP_USER=your_email@163.com
SMTP_PASS=xxxx xxxx xxxx xxxx
MAIL_TO=your_email@163.com
MAIL_FROM=your_email@163.com
